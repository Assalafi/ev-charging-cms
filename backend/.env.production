# Environment
NODE_ENV=production

# Backend API
BACKEND_URL=https://api.ev-cms.com
BACKEND_PORT=3000

# Database
DB_HOST=your-production-db-host
DB_PORT=5432
DB_NAME=ev_charging_cms
DB_USER=your-production-db-user
DB_PASSWORD=your-production-db-password

# Security
JWT_SECRET=your-production-jwt-secret
COOKIE_SECRET=your-production-cookie-secret

# MQTT
MQTT_ENABLED=true
MQTT_BROKER=mqtt://your-production-mqtt-broker:1883
MQTT_USERNAME=your-production-mqtt-user
MQTT_PASSWORD=your-production-mqtt-password

# OCPP
OCPP_DEFAULT_VERSION=1.6
OCPP_WS_PORT=9000
OCPP_WS_HOST=0.0.0.0

# Logging
LOG_LEVEL=warn
LOG_FORMAT=json
