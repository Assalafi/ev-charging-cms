// Updated messageHandlers.js with OCPP 1.6 compliant authorization
const logger = require('../utils/logger');
const { Transaction, ChargingStation, sequelize } = require('../models');
const mqttClient = require('../mqtt/client');
const tagAuthService = require('../services/tagAuthorization');
const chargingSessionTracker = require('../services/chargingSessionTracker');

/**
 * Handle OCPP requests from charging stations
 */
async function handleRequest(chargePointId, action, uniqueId, payload) {
    logger.info(`Handling ${action} request from ${chargePointId}`);

    // Handle different OCPP actions
    switch (action) {
        case 'BootNotification':
            return handleBootNotification(chargePointId, uniqueId, payload);
        case 'Heartbeat':
            return handleHeartbeat(chargePointId, uniqueId);
        case 'StatusNotification':
            return handleStatusNotification(chargePointId, uniqueId, payload);
        case 'Authorize':
            return handleAuthorize(chargePointId, uniqueId, payload);
        case 'StartTransaction':
            return handleStartTransaction(chargePointId, uniqueId, payload);
        case 'StopTransaction':
            return handleStopTransaction(chargePointId, uniqueId, payload);
        case 'MeterValues':
            return handleMeterValues(chargePointId, uniqueId, payload);
        case 'DiagnosticsStatusNotification':
            return handleDiagnosticsStatusNotification(chargePointId, uniqueId, payload);
        case 'FirmwareStatusNotification':
            return handleFirmwareStatusNotification(chargePointId, uniqueId, payload);
        case 'DataTransfer':
            return handleDataTransfer(chargePointId, uniqueId, payload);
        case 'Reset':
            return handleReset(chargePointId, uniqueId, payload);
        default:
            logger.warn(`Unhandled OCPP action: ${action} from ${chargePointId}`);
            // Send a default response for unhandled actions
            return [3, uniqueId, {
                status: 'NotImplemented'
            }];
    }
}

/**
 * Handle BootNotification request
 */
async function handleBootNotification(chargePointId, uniqueId, payload) {
    try {
        logger.info(`Processing BootNotification from ${chargePointId}: ${JSON.stringify(payload)}`);

        // Store or update charging station info in database
        const stationData = {
            chargePointVendor: payload.chargePointVendor,
            chargePointModel: payload.chargePointModel,
            chargePointSerialNumber: payload.chargePointSerialNumber,
            firmwareVersion: payload.firmwareVersion,
            iccid: payload.iccid,
            imsi: payload.imsi,
            meterType: payload.meterType,
            meterSerialNumber: payload.meterSerialNumber
        };

        try {
            // Update or insert charging station record
            await sequelize.query(
                `INSERT INTO charging_stations 
                ("chargePointId", "chargePointVendor", "chargePointModel", "lastBootTime", "status") 
                VALUES ($1, $2, $3, NOW(), 'Accepted')
                ON CONFLICT ("chargePointId") 
                DO UPDATE SET 
                "chargePointVendor" = $2, 
                "chargePointModel" = $3, 
                "lastBootTime" = NOW(),
                "status" = 'Accepted'`,
                {
                    bind: [
                        chargePointId,
                        payload.chargePointVendor || 'Unknown',
                        payload.chargePointModel || 'Unknown'
                    ],
                    type: sequelize.QueryTypes.INSERT
                }
            );
        } catch (dbError) {
            logger.error(`Database error during BootNotification from ${chargePointId}:`, dbError);
            // Continue even if DB update fails
        }

        // Publish boot notification to MQTT
        mqttClient.publish(`ocpp/${chargePointId}/boot`, JSON.stringify({
            ...payload,
            timestamp: new Date().toISOString()
        }));

        // Return standard boot confirmation as per OCPP 1.6
        return [3, uniqueId, {
            status: 'Accepted',
            currentTime: new Date().toISOString(),
            interval: 300 // Heartbeat interval in seconds
        }];
    } catch (error) {
        logger.error(`Error handling boot notification from ${chargePointId}:`, error);
        return [3, uniqueId, {
            status: 'Rejected',
            currentTime: new Date().toISOString(),
            interval: 60 // Shorter interval on error
        }];
    }
}

/**
 * Handle Heartbeat request
 */
async function handleHeartbeat(chargePointId, uniqueId) {
    try {
        logger.debug(`Received Heartbeat from ${chargePointId}`);

        // Update last heartbeat time in database
        try {
            // Use the ChargingStation model to update the lastHeartbeat field
            const station = await ChargingStation.findOne({
                where: { chargePointId }
            });
            
            if (station) {
                // Update the lastHeartbeat time using the model's field name
                await station.update({
                    lastHeartbeat: new Date()
                });
                logger.debug(`Updated lastHeartbeat for ${chargePointId} to ${new Date().toISOString()}`);
            } else {
                logger.warn(`Station ${chargePointId} not found in database during heartbeat update`);
            }
        } catch (dbError) {
            logger.error(`Database error during Heartbeat from ${chargePointId}:`, dbError);
            // Continue even if DB update fails
        }

        // Publish heartbeat to MQTT
        mqttClient.publish(`ocpp/${chargePointId}/heartbeat`, JSON.stringify({
            timestamp: new Date().toISOString()
        }));

        // Return standard heartbeat response as per OCPP 1.6
        return [3, uniqueId, {
            currentTime: new Date().toISOString()
        }];
    } catch (error) {
        logger.error(`Error handling heartbeat from ${chargePointId}:`, error);
        return [3, uniqueId, {
            currentTime: new Date().toISOString()
        }];
    }
}

/**
 * Handle StatusNotification request
 */
async function handleStatusNotification(chargePointId, uniqueId, payload) {
    try {
        logger.info(`Processing StatusNotification from ${chargePointId}: ${JSON.stringify(payload)}`);

        // Store connector status in database
        const { connectorId, status, errorCode } = payload;
        
        try {
            // First try to update existing connector record
            const result = await sequelize.query(
                `UPDATE connectors 
                 SET status = $1, "errorCode" = $2, "updatedAt" = NOW() 
                 WHERE "chargePointId" = $3 AND "connectorId" = $4
                 RETURNING id`,
                {
                    bind: [status, errorCode, chargePointId, connectorId],
                    type: sequelize.QueryTypes.UPDATE
                }
            );
            
            // If no connector record exists, insert one
            if (!result[1] || result[1] === 0) {
                try {
                    await sequelize.query(
                        `INSERT INTO connectors 
                        ("chargePointId", "connectorId", status, "errorCode", "createdAt", "updatedAt") 
                        VALUES ($1, $2, $3, $4, NOW(), NOW())`,
                        {
                            bind: [chargePointId, connectorId, status, errorCode],
                            type: sequelize.QueryTypes.INSERT
                        }
                    );
                } catch (insertError) {
                    // If the connectors table doesn't exist, log but continue
                    if (!insertError.message.includes('relation "connectors" does not exist')) {
                        throw insertError;
                    }
                    logger.warn('Connectors table does not exist - status updates not being tracked');
                }
            }
        } catch (dbError) {
            logger.error(`Database error during StatusNotification from ${chargePointId}:`, dbError);
            // Continue even if DB update fails
        }

        // Publish status notification to MQTT
        mqttClient.publish(`ocpp/${chargePointId}/status`, JSON.stringify({
            ...payload,
            timestamp: new Date().toISOString()
        }));

        // Return standard status notification response as per OCPP 1.6
        return [3, uniqueId, {}];
    } catch (error) {
        logger.error(`Error handling status notification from ${chargePointId}:`, error);
        return [3, uniqueId, {}];
    }
}

/**
 * Handle Authorize request - OCPP 1.6 COMPLIANT IMPLEMENTATION
 */
async function handleAuthorize(chargePointId, uniqueId, payload) {
    try {
        const { idTag } = payload;
        
        logger.info(`Processing Authorize request from ${chargePointId} for tag: ${idTag}`);

        if (!idTag) {
            logger.warn(`Missing idTag in Authorize request from ${chargePointId}`);
            return [3, uniqueId, {
                idTagInfo: {
                    status: 'Invalid'
                }
            }];
        }

        // Check if tag is authorized using the TagAuthorizationService
        const authResult = await tagAuthService.isAuthorized(idTag);
        
        // Track authorization attempt
        await tagAuthService.trackAuthorizationAttempt(chargePointId, idTag, authResult.status);

        // Publish authorization to MQTT
        mqttClient.publish(`ocpp/${chargePointId}/authorize`, JSON.stringify({
            idTag,
            status: authResult.status,
            timestamp: new Date().toISOString()
        }));

        // Return OCPP 1.6 compliant response
        return [3, uniqueId, {
            idTagInfo: {
                status: authResult.status,
                expiryDate: authResult.expiryDate,
                parentIdTag: authResult.parentId
            }
        }];
 * Handle StartTransaction request - OCPP 1.6 COMPLIANT IMPLEMENTATION
 * 
 * @param {string} chargePointId - The ID of the charge point
 * @param {string} uniqueId - The unique ID of the request
 * @param {object} payload - The payload of the request
 * 
 * @returns {array} - The response to the request
 */
async function handleStartTransaction(chargePointId, uniqueId, payload) {
    try {
        logger.info(`Processing StartTransaction from ${chargePointId}:`, JSON.stringify(payload));

        // Normalize the payload object in case the properties don't exactly match our expectations
        const normalizedPayload = {
            connectorId: payload.connectorId || 1,
            idTag: payload.idTag || '',
            meterStart: payload.meterStart || 0,
            reservationId: payload.reservationId || null,
            timestamp: payload.timestamp || new Date().toISOString(),
            transactionId: Math.floor(Math.random() * 1000000) // Generate a random transaction ID
        };

        logger.info(`START TRANSACTION FULL DEBUG: Processing transaction for ${chargePointId}`);
        logger.info(`START TRANSACTION FULL DEBUG: Normalized payload: ${JSON.stringify(normalizedPayload)}`);

        try {
            // First check if the tag is authorized for charging
            logger.info(`START TRANSACTION FULL DEBUG: Checking authorization for tag ${normalizedPayload.idTag}`);
            
            // Check authorization through the proper Sequelize model
            let authResult;
            try {
                authResult = await tagAuthService.isAuthorized(normalizedPayload.idTag);
                logger.info(`START TRANSACTION FULL DEBUG: Auth result for tag ${normalizedPayload.idTag}: ${JSON.stringify(authResult)}`);
                
                if (authResult.status !== 'Accepted') {
                    logger.warn(`START TRANSACTION FULL DEBUG: Rejected transaction start from ${chargePointId}: Tag ${normalizedPayload.idTag} status is ${authResult.status}`);
                    
                    return [3, uniqueId, {
                        transactionId: 0,
                        idTagInfo: {
                            status: authResult.status,
                            expiryDate: authResult.expiryDate
                        }
                    }];
                }
            } catch (authError) {
                logger.error(`START TRANSACTION FULL DEBUG: Error during tag authorization: ${authError.message}`);
                logger.error(authError);
                
                return [3, uniqueId, {
                    transactionId: 0,
                    idTagInfo: {
                        status: 'Invalid',
                        info: 'Authorization service error: ' + authError.message
                    }
                }];
            }
                    status: 'Invalid',
                    info: 'Authorization service error: ' + authError.message
                }
            }];
        }

        // ======== METER VALUE HANDLING - OCPP 1.6 COMPLIANT ========
        // Normalize the meter start value
        normalizedPayload.meterStart = payload.meterStart !== undefined ? parseFloat(payload.meterStart) : 0;
        
        // If meterStart is 0, try multiple fallback strategies to get a non-zero value
        if (normalizedPayload.meterStart === 0) {
            logger.info(`Received meterStart=0 for ${chargePointId}, trying to find a better value`);
            
            try {
                // 1. First strategy: Check for recent MeterValues messages
                try {
                    const { OcppMessage } = require('../models');
                    const recentMeterValue = await OcppMessage.findOne({
                        where: {
                            chargePointId: chargePointId,
                            message_type: 'MeterValues',
                            direction: 'Inbound'
                        },
                        order: [['timestamp', 'DESC']]
                    });
                    
                    if (recentMeterValue && recentMeterValue.payload) {
                        try {
                            const meterValuePayload = JSON.parse(recentMeterValue.payload);
                            if (meterValuePayload.meterValue && meterValuePayload.meterValue.length > 0) {
                                const sampledValues = meterValuePayload.meterValue[0].sampledValue;
                                if (sampledValues && Array.isArray(sampledValues)) {
                                    const energyValue = sampledValues.find(sv => 
                                        sv.measurand === 'Energy.Active.Import.Register' || !sv.measurand
                                    );
                                    
                                    if (energyValue && energyValue.value) {
                                        normalizedPayload.meterStart = parseFloat(energyValue.value);
                                        logger.info(`Using recent MeterValues reading: ${normalizedPayload.meterStart} for ${chargePointId}`);
                                    }
                                }
                            }
                        } catch (parseError) {
                            logger.warn(`Error parsing meter value payload: ${parseError.message}`);
                        }
                    }
                } catch (ocppError) {
                    logger.warn(`Error checking recent meter values: ${ocppError.message}`);
                }
                
                // 2. Second strategy: Use connector's stored meter value as fallback
                if (normalizedPayload.meterStart === 0) {
                    const { Connector } = require('../models');
                    const connector = await Connector.findOne({
                        where: {
                            chargePointId: chargePointId,
                            connectorId: normalizedPayload.connectorId
                        }
                    });
                    
                    if (connector && connector.meterValue) {
                        normalizedPayload.meterStart = parseFloat(connector.meterValue);
                        logger.info(`Using connector's stored meter value: ${normalizedPayload.meterStart} for ${chargePointId}`);
                    } else {
                        // 3. Third strategy: Check for previous transactions
                        const latestTransaction = await Transaction.findOne({
                            where: {
                                chargePointId: chargePointId,
                                connectorId: normalizedPayload.connectorId,
                                status: 'Completed'
                            },
                            order: [['stopTime', 'DESC']]
                        });
                        
                        if (latestTransaction && latestTransaction.stopMeterValue) {
                            normalizedPayload.meterStart = parseFloat(latestTransaction.stopMeterValue);
                            logger.info(`Using previous transaction's stop meter value: ${normalizedPayload.meterStart} for ${chargePointId}`);
                        } else {
                            logger.warn(`No usable meter value found for ${chargePointId}:${normalizedPayload.connectorId}, using 0`);
                        }
                    }
                }
            } catch (error) {
                logger.error(`Error retrieving meter values for ${chargePointId}: ${error.message}`);
            }
        } else {
            // Non-zero meterStart was provided, which is good
            logger.info(`Using provided non-zero meter start value: ${normalizedPayload.meterStart} for ${chargePointId}`);
        }
        
        // Ensure we have a valid numeric meter value
        normalizedPayload.meterStart = isNaN(normalizedPayload.meterStart) ? 0 : normalizedPayload.meterStart;

        try {
            // Create a new transaction record using Sequelize model
            const transaction = await Transaction.create({
                transactionId: normalizedPayload.transactionId,
                chargePointId,
                connectorId: normalizedPayload.connectorId,
                idTag: normalizedPayload.idTag,
                startTime: new Date(normalizedPayload.timestamp),
                startMeterValue: normalizedPayload.meterStart,
                energyDelivered: 0,
                status: 'InProgress'
            });
            
            logger.info(`Created transaction ${transaction.transactionId} for ${chargePointId} with start meter value ${normalizedPayload.meterStart}`);
            
            // Update connector status to Charging
            try {
                await updateConnectorStatus(chargePointId, normalizedPayload.connectorId, 'Charging', normalizedPayload.transactionId);
            } catch (connError) {
                logger.error(`Error updating connector status for ${chargePointId}:`, connError);
                // Continue with transaction even if connector update fails
            }
            
            // Initialize real-time charging session tracking
            const initialMeterValue = [
                {
                    timestamp: normalizedPayload.timestamp,
                    sampledValue: [
                        {
                            value: normalizedPayload.meterStart.toString(),
                            context: 'Transaction.Begin',
                            measurand: 'Energy.Active.Import.Register',
                            unit: 'Wh'
                        }
                    ]
                }
            ];
            
            // Initialize the charging session tracker with the initial meter value
            if (chargingSessionTracker) {
                chargingSessionTracker.startSession(normalizedPayload.transactionId, initialMeterValue, normalizedPayload.meterStart);
                logger.info(`Started real-time tracking for transaction ${normalizedPayload.transactionId}`);
            } else {
                logger.warn(`ChargingSessionTracker not available, real-time tracking disabled for transaction ${normalizedPayload.transactionId}`);
            }
            
            // Publish transaction start event to MQTT
            if (mqttClient) {
                mqttClient.publish(`ocpp/transactions/${normalizedPayload.transactionId}/start`, 
                    JSON.stringify({
                        timestamp: new Date().toISOString(),
                        chargePointId,
                        connectorId: normalizedPayload.connectorId,
                        transactionId: normalizedPayload.transactionId,
                        idTag: normalizedPayload.idTag,
                        meterStart: normalizedPayload.meterStart
                    })
                );
                
                // Also publish status update to MQTT for real-time UI updates
                mqttClient.publish(`ocpp/${chargePointId}/status`, JSON.stringify({
                    connectorId: normalizedPayload.connectorId,
                    status: 'Charging',
                    transactionId: normalizedPayload.transactionId,
                    timestamp: new Date().toISOString()
                }));
            }
            
            // Return OCPP 1.6 compliant response
            return [3, uniqueId, {
                transactionId: normalizedPayload.transactionId,
                idTagInfo: {
                    status: authResult.status,
                    expiryDate: authResult.expiryDate,
                    parentIdTag: authResult.parentId
                }
            }];
            
        } catch (dbError) {
            logger.error(`Database error during StartTransaction from ${chargePointId}:`, dbError);
            throw dbError; // Re-throw to be caught by outer try-catch
        }
    } catch (error) {
        logger.error(`Error handling StartTransaction from ${chargePointId}:`, error);
        
        // Generate fallback transaction ID for recovery
        const fallbackTransactionId = Math.floor(Math.random() * 1000000) + 1;
        logger.info(`Using fallback transaction ID: ${fallbackTransactionId} for error recovery`);

        // Return rejection with proper error information
        return [3, uniqueId, {
            transactionId: fallbackTransactionId,
            idTagInfo: {
                status: 'Invalid',
                info: 'Internal server error'
            }
        }];
    }
}

/**
 * Handle Reset request
 * Processes both Soft and Hard reset types according to OCPP 1.6 specification
 */
async function handleReset(chargePointId, uniqueId, payload) {
    try {
        // Enhanced debugging - dump full payload structure
        logger.info(`Processing Reset request from ${chargePointId}. Payload:`, JSON.stringify(payload));
        logger.info(`Payload type: ${typeof payload}, keys: ${Object.keys(payload).join(', ')}`);
        
        // The OCPP 1.6 spec requires a 'type' field in the Reset payload
        // It should be a string with either "Soft" or "Hard" value
        let resetType = "Soft"; // Default to Soft reset
        
        if (payload) {
            if (payload.Type !== undefined) {
                resetType = payload.Type;
                logger.debug(`Found PascalCase Type in payload: ${resetType}`);
            } else if (payload.type !== undefined) {
                resetType = payload.type;
                logger.debug(`Found lowercase type in payload: ${resetType}`);
            } else {
                // If we don't have a type field, check if the payload itself is the type
                if (typeof payload === 'string' && (payload === 'Soft' || payload === 'Hard')) {
                    resetType = payload;
                    logger.debug(`Payload itself appears to be the reset type: ${resetType}`);
                } else {
                    logger.warn(`No type field found in Reset payload. Using default: ${resetType}`);
                }
            }
        } else {
            logger.warn(`Reset payload is empty or undefined. Using default: ${resetType}`);
        }
        
        // Log the resolved reset type
        logger.debug(`Reset request received: ${resetType}`);
        
        // Publish reset event to MQTT
        mqttClient.publish(`ocpp/${chargePointId}/reset`, JSON.stringify({
            type: resetType,
            timestamp: new Date().toISOString()
        }));
        
        // In a real implementation, you might want to do more based on reset type
        // For a Hard reset, you might want to clear all transactions and status
        // For a Soft reset, you might want to just reset the software
        
        // Acknowledge the reset request
        return [3, uniqueId, {
            status: "Accepted"
        }];
    } catch (error) {
        logger.error(`Error handling Reset from ${chargePointId}:`, error);
        
        // Return rejection
        return [3, uniqueId, {
            status: "Rejected"
        }];
    }
}

/**
 * Handle StopTransaction request - OCPP 1.6 COMPLIANT IMPLEMENTATION
 */
async function handleStopTransaction(chargePointId, uniqueId, payload) {
    try {
        logger.info(`Processing StopTransaction from ${chargePointId}: ${JSON.stringify(payload)}`);
        
        // Normalize the payload to handle different formats
        const normalizedPayload = {
            transactionId: payload.transactionId,
            meterStop: payload.meterStop || 0,
            timestamp: payload.timestamp || new Date().toISOString(),
            reason: payload.reason || 'Local',
            idTag: payload.idTag || null
        };
        
        // Validate required fields
        if (!normalizedPayload.transactionId) {
            logger.error(`Missing required field transactionId in StopTransaction from ${chargePointId}`);
            return [3, uniqueId, {}]; // Empty response as per OCPP 1.6
        }
        
        // Find the transaction to update
        let transaction;
        try {
            // Find the transaction using Sequelize model
            transaction = await Transaction.findOne({
                where: {
                    transactionId: normalizedPayload.transactionId,
                    status: 'InProgress'
                }
            });
            
            if (!transaction) {
                logger.warn(`Transaction ${normalizedPayload.transactionId} not found or not in progress for ${chargePointId}`);
                
                // Per OCPP 1.6, we still return a success response even if transaction not found
                return [3, uniqueId, {}];
            }
            
            // Validate meter values
            const startMeterValue = transaction.startMeterValue || 0;
            if (normalizedPayload.meterStop < startMeterValue) {
                logger.warn(`Invalid meter values: start=${startMeterValue}, stop=${normalizedPayload.meterStop}`);
                // We'll still continue with the transaction
            }
            
            // Calculate energy delivered
            const energyDelivered = Math.max(0, (normalizedPayload.meterStop - startMeterValue) / 1000); // Convert to kWh if needed
            
            // Calculate the transaction amount based on current pricing settings
            let transactionAmount = 0;
            try {
                const { Settings } = require('../models');
                // Get pricing settings from database
                const pricingSettings = await Settings.findAll({ 
                    where: { category: 'pricing' },
                    attributes: ['key', 'value']
                });
                
                // Convert to settings object
                const settings = {};
                pricingSettings.forEach(setting => {
                    settings[setting.key] = setting.value?.data;
                });
                
                // Get base rate with fallback
                const baseRate = settings.baseRate || 120; // Default to 120 if not set
                const minimumCharge = settings.minimumCharge || 500; // Default to 500 if not set
                
                // Calculate raw amount
                let amount = energyDelivered * baseRate;
                
                // Apply minimum charge
                amount = Math.max(amount, minimumCharge);
                
                // Apply member discount if applicable
                const isMember = transaction.idTag && transaction.idTag.includes('MEMBER');
                if (isMember) {
                    const memberDiscount = settings.memberDiscount || 10; // Default to 10% if not set
                    amount = amount * (1 - memberDiscount / 100);
                }
                
                transactionAmount = amount;
                logger.info(`Calculated transaction amount: ${transactionAmount} for transaction ${transaction.transactionId}`);
            } catch (priceError) {
                logger.error(`Error calculating transaction amount:`, priceError);
                // Default minimum amount if calculation fails
                transactionAmount = 500;
            }
            
            // Update the transaction
            await transaction.update({
                status: 'Completed',
                stopTime: new Date(normalizedPayload.timestamp),
                stopMeterValue: normalizedPayload.meterStop,
                energyDelivered: energyDelivered,
                amount: transactionAmount,
                reason: normalizedPayload.reason
            });
            
            logger.info(`Completed transaction ${transaction.transactionId} for ${chargePointId}`);
            
            // Update connector status to Available
            try {
                await updateConnectorStatus(chargePointId, transaction.connectorId, 'Available', null);
                logger.info(`Updated connector ${transaction.connectorId} status to Available for station ${chargePointId}`);
            } catch (connError) {
                logger.error(`Error updating connector status for ${chargePointId}:`, connError);
                // Continue with transaction even if connector update fails
            }
            
            // End the real-time charging session tracking
            if (chargingSessionTracker) {
                // Get final energy consumption from tracker if available
                const sessionData = chargingSessionTracker.endSession(normalizedPayload.transactionId, normalizedPayload.meterStop);
                
                if (sessionData && sessionData.totalEnergy > 0) {
                    // If we have more accurate data from the session tracker, update the transaction with it
                    const trackedEnergyKWh = sessionData.totalEnergy / 1000; // Convert Wh to kWh
                    
                    // Only update if the tracked energy is reasonable (greater than 0 and not extremely high)
                    if (trackedEnergyKWh > 0 && trackedEnergyKWh < 1000) {
                        logger.info(`Updating transaction ${transaction.transactionId} with tracked energy: ${trackedEnergyKWh} kWh`);
                        
                        // Update the transaction with more accurate energy data
                        await transaction.update({
                            energyDelivered: trackedEnergyKWh,
                            // Recalculate amount based on the more accurate energy reading
                            amount: Math.max(trackedEnergyKWh * (settings?.baseRate || 120), settings?.minimumCharge || 500)
                        });
                    }
                }
                
                logger.info(`Ended real-time tracking for transaction ${normalizedPayload.transactionId}`);
            }
            
            // Publish transaction stop to MQTT for real-time UI updates
            if (mqttClient) {
                // Publish detailed transaction data for real-time dashboard updates
                mqttClient.publish(`ocpp/transactions/${normalizedPayload.transactionId}/stop`, JSON.stringify({
                    timestamp: new Date().toISOString(),
                    chargePointId,
                    connectorId: transaction.connectorId,
                    transactionId: normalizedPayload.transactionId,
                    meterStop: normalizedPayload.meterStop,
                    energyDelivered: transaction.energyDelivered,
                    duration: Math.floor((new Date(normalizedPayload.timestamp) - new Date(transaction.startTime)) / 1000), // Duration in seconds
                    reason: normalizedPayload.reason
                }));
                
                // Also publish general status update to MQTT
                mqttClient.publish(`ocpp/${chargePointId}/status`, JSON.stringify({
                    connectorId: transaction.connectorId,
                    status: 'Available',
                    timestamp: new Date().toISOString()
                }));
            }
            
            // Return OCPP 1.6 compliant response (empty payload for StopTransaction)
            return [3, uniqueId, {}];
        } catch (dbError) {
            logger.error(`Database error during StopTransaction from ${chargePointId}:`, dbError);
            throw dbError; // Re-throw to be caught by outer try-catch
        }
    } catch (error) {
        logger.error(`Error handling StopTransaction from ${chargePointId}:`, error);
        
        // Return empty response even in error case per OCPP 1.6
        return [3, uniqueId, {}];
    }
}

/**
 * Handle MeterValues request - OCPP 1.6 COMPLIANT IMPLEMENTATION
 */
async function handleMeterValues(chargePointId, uniqueId, payload) {
    try {
        logger.info(`Processing MeterValues from ${chargePointId}: ${JSON.stringify(payload)}`);
        
        // Get our comprehensive MeterValueProcessor
        const meterValueProcessor = require('../services/MeterValueProcessor');
        
        // Process MeterValues message through the processor
        const success = await meterValueProcessor.processMeterValue(chargePointId, payload);
        
        if (!success) {
            logger.warn(`MeterValueProcessor failed to process values from ${chargePointId}`);
            // Still return success as per OCPP spec
        } else {
            logger.debug(`Successfully processed meter values from ${chargePointId}`);
            
            // If this is part of a transaction, update transaction energy and real-time tracking
            if (payload.transactionId) {
                try {
                    // Update real-time charging session tracker with meter values first
                    if (payload.meterValue && Array.isArray(payload.meterValue)) {
                        logger.info(`Processing meter values for transaction ${payload.transactionId}: ${JSON.stringify(payload.meterValue)}`);
                        
                        // Extract energy value directly from the meter values for immediate feedback
                        let directEnergyValue = null;
                        let directSocValue = null;
                        let directPowerValue = null;
                        for (const sample of payload.meterValue) {
                            if (sample.sampledValue) {
                                for (const value of sample.sampledValue) {
                                    if (value.measurand === 'Energy.Active.Import.Register') {
                                        directEnergyValue = parseFloat(value.value);
                                        logger.info(`Found direct energy value: ${directEnergyValue} ${value.unit || 'Wh'}`);
                                    } else if (value.measurand === 'SoC') {
                                        directSocValue = parseFloat(value.value);
                                        logger.info(`Found direct SoC value: ${directSocValue}%`);
                                    } else if (value.measurand === 'Power.Active.Import') {
                                        directPowerValue = parseFloat(value.value);
                                        logger.info(`Found direct power value: ${directPowerValue} ${value.unit || 'W'}`);
                                    }
                                }
                            }
                        }
                        
                        // Try to update via the session tracker first
                        let updateResult = null;
                        if (chargingSessionTracker) {
                            updateResult = chargingSessionTracker.updateMeterValue(payload.transactionId, payload.meterValue);
                            logger.info(`Charging session tracker update for transaction ${payload.transactionId}: ${updateResult ? 'SUCCESS' : 'FAILED'}`);
                        } else {
                            logger.warn(`ChargingSessionTracker not available for transaction ${payload.transactionId}`);
                        }
                        
                        // Get the transaction record
                        const transaction = await Transaction.findOne({
                            where: { 
                                transactionId: payload.transactionId,
                                status: 'InProgress'
                            }
                        });
                        
                        if (!transaction) {
                            logger.warn(`No active transaction found with ID ${payload.transactionId}`);
                        } else {
                            // Get session stats if available
                            let sessionStats = null;
                            if (chargingSessionTracker) {
                                sessionStats = chargingSessionTracker.getSessionStats(payload.transactionId);
                                logger.info(`Session stats for transaction ${payload.transactionId}: ${sessionStats ? JSON.stringify(sessionStats) : 'NOT AVAILABLE'}`);
                            }
                            
                            // Calculate energy value - use the most reliable source
                            let energyKWh = 0;
                            
                            // Get the startMeterValue - critical for calculations
                            const startMeterValue = transaction.startMeterValue || 0;
                            logger.info(`Start meter value for transaction ${payload.transactionId}: ${startMeterValue} Wh`);
                            
                            // 1. Direct calculation from meter values - most reliable
                            if (directEnergyValue !== null) {
                                // Convert to same unit first (assume Wh if not specified)
                                let currentEnergyWh = directEnergyValue;
                                let startEnergyWh = startMeterValue;
                                
                                // Calculate energy consumed in kWh
                                energyKWh = Math.max(0, (currentEnergyWh - startEnergyWh)) / 1000; // Convert to kWh
                                logger.info(`DIRECT CALCULATION: Energy consumed: ${energyKWh.toFixed(2)} kWh (${currentEnergyWh} - ${startEnergyWh}) / 1000`);
                            } 
                            // 2. Session tracker as fallback
                            else if (sessionStats && sessionStats.totalEnergy > 0) {
                                energyKWh = sessionStats.totalEnergy / 1000; // Convert Wh to kWh
                                logger.info(`TRACKER CALCULATION: Energy consumed: ${energyKWh.toFixed(2)} kWh`);
                            }
                            
                            // Get power value - either direct or calculated
                            let currentPower = directPowerValue || sessionStats?.currentPower || 0;
                            
                            // Get battery percentage - either direct or estimated
                            let batteryPercentage = directSocValue || sessionStats?.batteryPercentage || null;
                            
                            // Calculate duration
                            const duration = Math.floor((new Date() - new Date(transaction.startTime)) / 1000); // seconds
                            
                            // Always update transaction in database
                            await transaction.update({
                                energyDelivered: energyKWh
                            });
                            
                            logger.info(`Updated transaction ${payload.transactionId} with energy: ${energyKWh.toFixed(2)} kWh`);
                            
                            // Only publish if we have real energy consumption
                            if (energyKWh > 0) {
                                // Publish real-time energy consumption update to MQTT for UI updates
                                if (mqttClient) {
                                    const updateMessage = {
                                        timestamp: new Date().toISOString(),
                                        transactionId: payload.transactionId,
                                        chargePointId,
                                        energy: energyKWh,
                                        power: currentPower,
                                        batteryPercentage: batteryPercentage,
                                        duration: duration
                                    };
                                    
                                    logger.info(`Publishing energy update to MQTT: ${JSON.stringify(updateMessage)}`);
                                    mqttClient.publish(`ocpp/transactions/${payload.transactionId}/energy`, JSON.stringify(updateMessage));
                                    
                                    // Also publish to a station-specific topic for UI filtering
                                    mqttClient.publish(`ocpp/stations/${chargePointId}/energy`, JSON.stringify(updateMessage));
                                }
                            }
                        }
                    }
                } catch (updateError) {
                    logger.error(`Error updating transaction energy: ${updateError.message}`, updateError);
                    // Continue even if updating fails - we don't want to break the OCPP flow
                }
            }
        }
        
        // Publish raw meter values to MQTT for real-time monitoring
        if (payload.transactionId && mqttClient) {
            mqttClient.publish(`ocpp/transactions/${payload.transactionId}/metervalues`, 
                JSON.stringify({
                    timestamp: new Date().toISOString(),
                    chargePointId,
                    meterValues: payload.meterValue || []
                })
            );
        }
        
        // Return OCPP 1.6 compliant response (always an empty payload)
        return [3, uniqueId, {}];
    } catch (error) {
        logger.error(`Error handling MeterValues from ${chargePointId}:`, error);
        // Still return success response with empty payload per OCPP 1.6
        return [3, uniqueId, {}];
    }
}

/**
 * Handle DataTransfer request - OCPP 1.6 COMPLIANT IMPLEMENTATION
 */
async function handleDataTransfer(chargePointId, uniqueId, payload) {
    try {
        logger.info(`Processing DataTransfer from ${chargePointId}: ${JSON.stringify(payload)}`);
        
        // Extract data transfer details
        const vendorId = payload.vendorId || '';
        const messageId = payload.messageId || '';
        const data = payload.data || '';
        
        // Publish data transfer to MQTT
        mqttClient.publish(`ocpp/${chargePointId}/data_transfer`, JSON.stringify({
            vendorId,
            messageId,
            data,
            timestamp: new Date().toISOString()
        }));
        
        // Return OCPP 1.6 compliant response
        return [3, uniqueId, {
            status: 'Accepted'
        }];
    } catch (error) {
        logger.error(`Error handling DataTransfer from ${chargePointId}:`, error);
        return [3, uniqueId, {
            status: 'Rejected',
            info: 'Internal server error'
        }];
    }
}

/**
 * Handle DiagnosticsStatusNotification request - OCPP 1.6 COMPLIANT IMPLEMENTATION
 */
async function handleDiagnosticsStatusNotification(chargePointId, uniqueId, payload) {
    try {
        logger.info(`Processing DiagnosticsStatusNotification from ${chargePointId}: ${JSON.stringify(payload)}`);
        
        // Extract status
        const status = payload.status || '';
        
        // Publish diagnostics status to MQTT
        mqttClient.publish(`ocpp/${chargePointId}/diagnostics_status`, JSON.stringify({
            status,
            timestamp: new Date().toISOString()
        }));
        
        // Return OCPP 1.6 compliant response (empty payload)
        return [3, uniqueId, {}];
    } catch (error) {
        logger.error(`Error handling DiagnosticsStatusNotification from ${chargePointId}:`, error);
        return [3, uniqueId, {}];
    }
}

/**
 * Handle FirmwareStatusNotification request - OCPP 1.6 COMPLIANT IMPLEMENTATION
 */
async function handleFirmwareStatusNotification(chargePointId, uniqueId, payload) {
    try {
        logger.info(`Processing FirmwareStatusNotification from ${chargePointId}: ${JSON.stringify(payload)}`);
        
        // Extract status
        const status = payload.status || '';
        
        // Publish firmware status to MQTT
        mqttClient.publish(`ocpp/${chargePointId}/firmware_status`, JSON.stringify({
            status,
            timestamp: new Date().toISOString()
        }));
        
        // Update charging station firmware status in database
        try {
            await sequelize.query(
                `UPDATE charging_stations 
                 SET "firmwareUpdateStatus" = $1, "lastUpdated" = NOW() 
                 WHERE "chargePointId" = $2`,
                {
                    bind: [status, chargePointId],
                    type: sequelize.QueryTypes.UPDATE
                }
            );
        } catch (dbError) {
            logger.error(`Database error during FirmwareStatusNotification from ${chargePointId}:`, dbError);
            // Continue even if DB update fails
        }
        
        // Return OCPP 1.6 compliant response (empty payload)
        return [3, uniqueId, {}];
    } catch (error) {
        logger.error(`Error handling FirmwareStatusNotification from ${chargePointId}:`, error);
        return [3, uniqueId, {}];
    }
}

// Export the handleRequest function for use in other modules
module.exports = {
    handleRequest
};
