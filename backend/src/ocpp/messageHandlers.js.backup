/**
 * Handle DataTransfer request
 */
async function handleDataTransfer(chargePointId, uniqueId, payload) {
    try {
        logger.info(`Processing DataTransfer from ${chargePointId} with vendorId: ${payload.vendorId}, messageId: ${payload.messageId}`);

        // Check if this station exists, if not, auto-register it
        const existingStation = await ChargingStation.findOne({
            where: {
                chargePointId
            }
        });

        if (!existingStation) {
            logger.info(`Auto-registering station ${chargePointId} from DataTransfer message`);

            // Extract meter information if available
            let meterSerial = '';
            let meterType = '';

            if (payload.data && typeof payload.data === 'string') {
                try {
                    const parsedData = JSON.parse(payload.data);

                    if (parsedData.meters && parsedData.meters.length > 0) {
                        meterSerial = parsedData.meters[0].meterSerial || '';
                        meterType = parsedData.meters[0].type || '';
                        logger.info(`Extracted meter information: Serial=${meterSerial}, Type=${meterType}`);
                    }
                } catch (parseError) {
                    logger.warn(`Could not parse DataTransfer data payload: ${parseError.message}`);
                }
            }

            // Create a new station record
            await ChargingStation.create({
                chargePointId,
                name: `${chargePointId} (Auto-registered)`,
                model: 'Unknown Model',
                vendor: 'Unknown Vendor',
                status: 'Available',
                meterSerialNumber: meterSerial,
                meterType: meterType,
                lastConnection: new Date(),
                lastHeartbeat: new Date()
            });

            logger.info(`Successfully registered station ${chargePointId} from DataTransfer`);
        } else {
            // Update last connection time
            await existingStation.update({
                lastConnection: new Date(),
                lastHeartbeat: new Date()
            });

            // If we have meter information, update it
            if (payload.data && typeof payload.data === 'string') {
                try {
                    const parsedData = JSON.parse(payload.data);

                    if (parsedData.meters && parsedData.meters.length > 0) {
                        const meterSerial = parsedData.meters[0].meterSerial || '';
                        const meterType = parsedData.meters[0].type || '';

                        if (meterSerial && meterType) {
                            await existingStation.update({
                                meterSerialNumber: meterSerial,
                                meterType: meterType
                            });
                            logger.info(`Updated meter information for ${chargePointId}: Serial=${meterSerial}, Type=${meterType}`);
                        }
                    }
                } catch (parseError) {
                    logger.warn(`Could not parse DataTransfer data payload: ${parseError.message}`);
                }
            }
        }

        // Publish data transfer to MQTT
        mqttClient.publish(`ocpp/${chargePointId}/dataTransfer`, JSON.stringify({
            ...payload,
            timestamp: new Date().toISOString()
        }));

        // Always accept the data transfer
        return [3, uniqueId, {
            status: 'Accepted',
            data: {} // Optional data in response
        }];
    } catch (error) {
        logger.error(`Error handling data transfer from ${chargePointId}:`, error);

        // Always accept the data transfer even if there's an error
        // This is important for T001 which uses DataTransfer as its first message
        return [3, uniqueId, {
            status: 'Accepted',
            data: {}
        }];
    }
}

module.exports = {
    handleRequest
};